# Whitelist: only code, manuscript and JSON results are tracked.
*
!*/
!/README.md
!/LICENSE
!/requirements.txt
!/.gitignore
!/analysis_lock.md
!/Code/*.py
!/Code/*.sh
!/paper/*.py
!/paper/*.md
!/paper/figures/*.png
!/Result/*.json
!/Result/vr19/*.json
!/Result/vr24/*.json
!/Result/vr30/*.json
!/Result/vr36/*.json
!/Result/vr39/*.json
!/Result/vr46/*.json
__pycache__/
